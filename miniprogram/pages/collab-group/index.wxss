/* 覆盖 app.wxss 的 page / .page 内边距，对话页贴边铺满 */
page {
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: #eef2f7;
}

.collab-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #eef2f7;
}

.header {
  color: #ffffff;
  background: linear-gradient(145deg, #0f2c50 0%, #1a4a7a 80%);
}

.header-inner {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 28rpx 28rpx;
}

.back {
  width: 56rpx;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.heading {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.online {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.online-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #62e6a8;
}

.online-dot.off {
  background: #94a3b8;
}

.tip {
  margin: 20rpx 28rpx 0;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 24rpx;
  text-align: center;
}

.tip.error {
  color: #b42318;
  background: #feeceb;
}

.system-line {
  margin: 8rpx auto 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 44, 80, 0.06);
  color: #64748b;
  font-size: 21rpx;
  text-align: center;
  align-self: center;
}

.bubble-mine {
  background: #1268e8;
  color: #ffffff;
}

.send.disabled {
  background: #a8bdd8;
}

.chat {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.msg {
  margin-bottom: 28rpx;
}

.msg-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.avatar.driver { background: #64748b; }
.avatar.gate { background: #2563eb; }
.avatar.stacker { background: #ea580c; }
.avatar.dispatch { background: #0f766e; }
.avatar.system { background: #94a3b8; }

.msg-who {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.name {
  display: block;
  color: #0f2c50;
  font-size: 26rpx;
  font-weight: 700;
}

.role {
  color: #64748b;
  font-size: 20rpx;
}

.time {
  color: #94a3b8;
  font-size: 20rpx;
}

.bubble {
  margin-left: 80rpx;
  padding: 20rpx 24rpx;
  border-radius: 8rpx 20rpx 20rpx 20rpx;
  background: #ffffff;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.55;
  box-shadow: 0 4rpx 16rpx rgba(15, 44, 80, 0.06);
}

.machine-card {
  margin-left: 80rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  box-shadow: 0 6rpx 18rpx rgba(234, 88, 12, 0.08);
}

.machine-title {
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 700;
}

.machine-eta {
  margin-top: 10rpx;
  color: #0f2c50;
  font-size: 32rpx;
  font-weight: 700;
}

.machine-num {
  color: #ea580c;
  font-size: 40rpx;
}

.machine-route {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.machine-status {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #9a3412;
  background: #ffedd5;
  font-size: 22rpx;
  font-weight: 600;
}

.chat-pad {
  height: 24rpx;
}

.composer {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 44, 80, 0.08);
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.q-blue { color: #1d4ed8; background: #dbeafe; }
.q-orange { color: #c2410c; background: #ffedd5; }
.q-green { color: #047857; background: #d1fae5; }
.q-cyan { color: #0e7490; background: #cffafe; }

.input-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 26rpx;
}

.send {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 72rpx;
  margin-left: 16rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #1268e8;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}
