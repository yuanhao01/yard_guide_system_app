<!-- 场内导航：顶栏、转向提示、三维场图、底部剩余距离和结束 -->
<view class="nav-page">
  <!-- 对齐高保真 02：整块深蓝顶栏，不再叠系统绿导航栏 -->
  <view class="nav-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-header-inner">
      <view class="nav-back" bindtap="goBack">‹</view>
      <view class="nav-heading">
        <view class="nav-title">场内导航</view>
        <view class="nav-subtitle">前往 {{session.targetName || '--'}}</view>
      </view>
      <view class="nav-deco" aria-hidden="true"></view>
    </view>
  </view>

  <!-- 下一句转向提示：箭头 + 文案 -->
  <view class="banner">
    <view class="banner-arrow">{{instructionIcon}}</view>
    <view class="banner-text">{{instruction}}</view>
  </view>

  <!-- 三维堆场图和左上工具、右下缩放 -->
  <view class="map-wrap">
    <canvas type="webgl" id="yardCanvas" class="yard-canvas"
            bindtouchstart="onCanvasTouchStart"
            bindtouchmove="onCanvasTouchMove"
            bindtouchend="onCanvasTouchEnd"
            bindtouchcancel="onCanvasTouchEnd"></canvas>

    <view class="map-tools">
      <view class="tool compass" style="transform: rotate({{compassRotate}}deg);">
        <view class="compass-label">北</view>
        <view class="compass-arrow">▲</view>
      </view>
      <view class="tool voice {{voiceOn ? 'tool-on' : ''}}" bindtap="toggleVoice">
        <view class="tool-icon">◍</view>
        <view class="tool-label">语音播报\n{{voiceOn ? '开启' : '关闭'}}</view>
      </view>
      <view class="tool" bindtap="toggleFollow">
        <view class="tool-icon">{{followMode ? '⊕' : '⊞'}}</view>
        <view class="tool-label">{{followMode ? '跟车' : '全场'}}</view>
      </view>
      <view class="tool" bindtap="calibrateHeading">
        <view class="tool-icon">◎</view>
        <view class="tool-label">校准朝向</view>
      </view>
    </view>

    <view class="map-zoom">
      <!-- 当前路限速牌：红圈白底，放在右侧按钮栏最上面 -->
      <view class="speed-sign" wx:if="{{speedLimit}}">{{speedLimit}}</view>
      <view class="zoom-btn flat-btn" bindtap="toggleFlatMode">{{flatMode ? '3D' : '2D'}}</view>
      <view class="zoom-btn" bindtap="zoomIn">＋</view>
      <view class="zoom-btn" bindtap="zoomOut">－</view>
      <view class="zoom-btn zoom-reset" wx:if="{{viewAdjusted}}" bindtap="resetView">复位</view>
      <view class="zoom-btn locate-btn {{locating ? 'locating' : ''}}" bindtap="locateSelf">◎</view>
    </view>

    <view class="map-empty" wx:if="{{mapLoading && !mapError}}">地图加载中…</view>
    <view class="map-empty" wx:if="{{mapError}}">{{mapError}}</view>
  </view>

  <!-- 底部：目的地、剩余、预计、确认到达、退出 -->
  <view class="bottom-card">
    <view class="metrics">
      <view class="metric metric-dest">
        <view class="metric-cap">目的地</view>
        <view class="dest-name">{{session.targetName || '--'}}</view>
      </view>
      <view class="metric">
        <view class="metric-cap">剩余</view>
        <view class="metric-num blue">{{remainingDistance}}<text class="metric-unit">m</text></view>
      </view>
      <view class="metric">
        <view class="metric-cap">预计</view>
        <view class="metric-num orange">{{estimatedMinutes}}<text class="metric-unit">分钟</text></view>
      </view>
    </view>

    <view class="chips" wx:if="{{offYardHint}}">
      <view class="chip chip-warn">⚠ {{offYardHint}}，进入堆场后自动跟车</view>
    </view>

    <view class="chips" wx:if="{{oneWayHint}}">
      <view class="chip chip-warn">⚠ {{oneWayHint}}</view>
    </view>

    <view class="action-row">
      <button wx:if="{{arrivalSuggestion}}" class="arrival-btn" bindtap="confirmArrival">已到达，确认完成</button>
      <button wx:else class="arrival-btn arrival-btn-ghost" bindtap="confirmArrival">我已到达</button>
      <button class="exit-btn" bindtap="cancelNavigation">退出</button>
    </view>
  </view>
</view>
