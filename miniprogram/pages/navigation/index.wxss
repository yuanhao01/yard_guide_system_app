.navigation-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.navigation-map {
  width: 100%;
  height: 100%;
}

.instruction-panel {
  position: absolute;
  right: 22rpx;
  bottom: 34rpx;
  left: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12rpx 50rpx rgba(16, 39, 29, 0.2);
}

.instruction-top {
  display: flex;
  align-items: center;
}

.direction-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #147d55;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

.instruction-content {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.instruction-text {
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.target-text {
  margin-top: 8rpx;
  color: #75827c;
  font-size: 23rpx;
}

.metrics {
  display: flex;
  justify-content: space-around;
  margin-top: 26rpx;
  padding: 23rpx 0;
  border-top: 1rpx solid #e8eeeb;
  border-bottom: 1rpx solid #e8eeeb;
  text-align: center;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 700;
}

.metric-unit {
  margin-left: 4rpx;
  font-size: 21rpx;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  color: #7c8983;
  font-size: 21rpx;
}

.quality-good {
  color: #147d55;
}

.quality-weak {
  color: #c16c12;
}

.arrival-button {
  height: 82rpx;
  margin-top: 22rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #d58424;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.tools {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  color: #496058;
  font-size: 23rpx;
}

.tools .stop {
  color: #b42318;
}
