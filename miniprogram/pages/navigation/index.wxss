/* 导航页整屏铺满，场图占中间剩余高度 */
.nav-page {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #eef1f5;
}

/* 顶部标题栏 —— 对齐 02 整块深蓝，自定义导航栏 */
.nav-header {
  color: #ffffff;
  background: #0f2c50;
}

/* 返回、标题、装饰横排 */
.nav-header-inner {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 32rpx 28rpx;
  overflow: hidden;
}

/* 左上返回 */
.nav-back {
  z-index: 1;
  width: 56rpx;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

/* 标题文字区 */
.nav-heading {
  z-index: 1;
  flex: 1;
  min-width: 0;
}

/* 「场内导航」 */
.nav-title {
  font-size: 38rpx;
  font-weight: 700;
}

/* 「前往某某」 */
.nav-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

/* 顶栏右下装饰，不挡点击 */
.nav-deco {
  position: absolute;
  right: -20rpx;
  bottom: -10rpx;
  width: 180rpx;
  height: 120rpx;
  border-radius: 40rpx 0 0 80rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
  pointer-events: none;
}

/* 转向提示条 */
.banner {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #1268e8;
  box-shadow: 0 10rpx 28rpx rgba(18, 104, 232, 0.28);
}

/* 提示条左边大箭头 */
.banner-arrow {
  margin-right: 22rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

/* 提示条文案，太长打点 */
.banner-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 地图区 */
.map-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

/* 三维场图画布铺满 */
.yard-canvas {
  width: 100%;
  height: 100%;
}

/* 左上角指南针、语音、跟车、校准 */
.map-tools {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
}

/* 单个工具按钮 */
.tool {
  width: 104rpx;
  margin-bottom: 18rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 20rpx rgba(15, 44, 80, 0.14);
  color: #5a6a80;
  font-size: 20rpx;
  text-align: center;
}

/* 语音开着时蓝字 */
.tool-on {
  color: #1268e8;
}

/* 工具图标 */
.tool-icon {
  font-size: 32rpx;
  line-height: 1.2;
}

/* 工具下面两行字 */
.tool-label {
  margin-top: 4rpx;
  line-height: 1.3;
  white-space: pre-line;
}

/* 圆形指南针 */
.tool.compass {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
  padding: 0;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.05s linear;
}

/* 指南针上的「北」 */
.compass-label {
  color: #33415c;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

/* 指南针红箭头 */
.compass-arrow {
  margin-top: 2rpx;
  color: #e0483a;
  font-size: 22rpx;
  line-height: 1;
}

/* 右下角 2D/3D、放大、缩小、复位、定位 */
.map-zoom {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
}

/* 缩放列里的小方钮 */
.zoom-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-top: 14rpx;
  padding: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 20rpx rgba(15, 44, 80, 0.14);
  color: #33415c;
  font-size: 34rpx;
  line-height: 1;
  box-sizing: border-box;
}

/* 「复位」二字稍小 */
.zoom-reset {
  color: #1268e8;
  font-size: 22rpx;
}

/* 「2D / 3D」切换 */
.flat-btn {
  color: #0f2c50;
  font-size: 24rpx;
  font-weight: 700;
}

/* 定位自己 */
.locate-btn {
  color: #1268e8;
  font-size: 38rpx;
}

/* 正在定位时灰掉 */
.locating {
  color: #9aa7b8;
}

/* 地图加载中或失败时的中间提示 */
.map-empty {
  position: absolute;
  top: 50%;
  right: 60rpx;
  left: 60rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #8a5a12;
  font-size: 24rpx;
  text-align: center;
}

/* 底部信息卡 */
.bottom-card {
  padding: 28rpx 32rpx 34rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(15, 44, 80, 0.12);
}

/* 目的地、剩余、预计三列 */
.metrics {
  display: flex;
  align-items: flex-end;
}

/* 后两列带左边竖线 */
.metric {
  padding-left: 26rpx;
  border-left: 1rpx solid #e6eaf0;
  text-align: left;
}

/* 目的地占满左边，不要竖线 */
.metric-dest {
  flex: 1;
  min-width: 0;
  padding-left: 0;
  border-left: none;
}

/* 剩余和预计与目的地隔开 */
.metric:not(.metric-dest) {
  margin-left: 26rpx;
}

/* 「目的地 / 剩余 / 预计」小标题 */
.metric-cap {
  color: #8b96a5;
  font-size: 22rpx;
}

/* 目的地名称，太长打点 */
.dest-name {
  margin-top: 8rpx;
  overflow: hidden;
  color: #1c2733;
  font-size: 34rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 剩余米数、预计分钟大数字 */
.metric-num {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

/* 剩余米数蓝色 */
.metric-num.blue {
  color: #1268e8;
}

/* 预计分钟橙色 */
.metric-num.orange {
  color: #ef7a1a;
}

/* 「m / 分钟」单位 */
.metric-unit {
  margin-left: 2rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 场外、逆行、限速提示条外框 */
.chips {
  display: flex;
  margin-top: 22rpx;
}

/* 单条提示胶囊 */
.chip {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

/* 两条提示并排时中间留缝 */
.chip + .chip {
  margin-left: 18rpx;
}

/* 黄色警告：场外、逆行 */
.chip-warn {
  color: #8a5a12;
  background: #fdf3dd;
}

/* 红色限速 */
.chip-danger {
  color: #b42318;
  background: #fdeceb;
}

/* 限速数字小圆 */
.chip-badge {
  display: inline-block;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  border: 3rpx solid #d0392b;
  border-radius: 50%;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
  vertical-align: middle;
}

/* 「已到达，确认完成」绿按钮 */
.arrival-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #18a05a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.2;
  box-sizing: border-box;
}

/* 去掉微信按钮边框 */
.arrival-btn::after {
  border: none;
}

/* 还没到时的浅绿「我已到达」 */
.arrival-btn-ghost {
  color: #18a05a;
  background: #e8f8ef;
}

/* 定位质量和语音状态 */
.status-line {
  margin-top: 22rpx;
  color: #6b7889;
  font-size: 23rpx;
  text-align: center;
}

/* 定位状态小圆点默认灰 */
.status-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #b9c4d1;
  vertical-align: middle;
}

/* 定位正常绿点 */
.status-dot.quality-good {
  background: #18a05a;
}

/* 定位较弱橙点 */
.status-dot.quality-weak {
  background: #ef7a1a;
}

/* 报告异常 / 结束导航 */
.tools-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef1f5;
  color: #5a6a80;
  font-size: 24rpx;
}

/* 「结束导航」红色 */
.tools-row .stop {
  color: #b42318;
}
