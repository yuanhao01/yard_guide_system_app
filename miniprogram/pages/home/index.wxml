<!-- 首页：顶部堆场/岗位，下面按身份显示协同群或选贝位 -->
<view class="page home-page">
  <!-- 顶部深绿从状态栏一直铺下来，中间不再断一层 -->
  <view class="hero" style="padding-top: {{statusBarHeight + 8}}px;">
    <view class="hero-brand">堆场引导系统</view>
    <view class="hero-top">
      <view>
        <view class="hero-label">{{isFieldRole ? (roleLabel || '现场岗位') : '当前堆场'}}</view>
        <view class="hero-title">{{isFieldRole ? (displayName || yardName || '现场岗位') : (yardName || '尚未选择堆场')}}</view>
      </view>
      <view class="yard-switch" wx:if="{{canSwitchYard}}" catchtap="chooseYard">
        <view class="yard-switch-name">{{yardName || '选择堆场'}}</view>
        <view class="yard-switch-action">切换</view>
      </view>
    </view>
    <view class="hero-status">
      <text class="status-dot"></text>
      {{isFieldRole ? ((yardName || '') + (yardName ? ' · ' : '') + '协同服务已连接') : '导航服务已连接'}}
    </view>
  </view>

  <!-- 现场岗位：协同群列表 -->
  <block wx:if="{{isFieldRole}}">
    <view class="section-title">协同交流群</view>
    <view wx:if="{{!collabGroups.length}}" class="empty-card">
      <view class="empty-title">暂无进行中的协同任务</view>
      <view class="empty-desc">司机开始导航后，系统会自动建群并把本场现场人员拉进去。下拉可刷新。</view>
    </view>
    <view
      wx:for="{{collabGroups}}"
      wx:key="id"
      class="collab-card"
      bindtap="openRoleGroup"
      data-id="{{item.id}}"
    >
      <view class="collab-unread" wx:if="{{item.unreadCount > 0}}">{{item.unreadText}}</view>
      <view class="collab-head">
        <view class="collab-tag">任务协同</view>
        <view class="collab-status">进行中</view>
      </view>
      <view class="collab-title">{{item.title}}</view>
      <view class="collab-desc">{{item.desc}}</view>
      <view class="collab-foot">
        <view class="collab-members">{{item.memberText}}</view>
        <view class="collab-time" wx:if="{{item.lastMsgTimeText}}">{{item.lastMsgTimeText}}</view>
      </view>
    </view>
  </block>

  <!-- 司机：进行中任务、去贝位、验箱区/出场口、协同群、安全提示 -->
  <block wx:else>
    <view wx:if="{{currentSession}}" class="current-card" bindtap="continueNavigation">
      <view class="current-tag">进行中</view>
      <view class="current-title">{{currentTitle}}</view>
      <view class="current-detail">{{currentDetail}}</view>
      <view class="current-action">{{currentAction}}</view>
    </view>

    <!-- 去作业贝位：手动选和扫码放在同一张卡里 -->
    <view class="section-title">去作业贝位</view>
    <view class="job-card">
      <view class="job-head">
        <view class="action-icon select-icon">贝</view>
        <view class="action-content">
          <view class="action-title">导航到作业贝位</view>
          <view class="action-desc">提箱、还箱都从这里选目的地</view>
        </view>
      </view>
      <view class="job-actions">
        <view class="job-btn job-btn-main" bindtap="selectTarget">手动选择贝位</view>
        <view class="job-btn" bindtap="scanCode">扫码导航</view>
      </view>
    </view>

    <view class="safety-card">
      <view class="safety-title">行车安全提示</view>
      <view class="safety-text">请在停车状态下操作手机。路线仅作场内辅助，请始终服从现场交通标识和人员指挥。</view>
    </view>

    <!-- 验箱区、出场口：点一下就按当前位置规划路线 -->
    <view class="section-title"></view>
    <view class="section-title">一键导航</view>
    <view class="quick-grid">
      <view class="quick-card {{specialLoading === 'safety' ? 'quick-busy' : ''}}" bindtap="goSafety">
        <view class="quick-icon quick-icon-safety">验</view>
        <view class="quick-title">验箱区</view>
        <view class="quick-desc">{{specialLoading === 'safety' ? '规划中…' : '从当前位置出发'}}</view>
      </view>
      <view class="quick-card {{specialLoading === 'exit' ? 'quick-busy' : ''}}" bindtap="goExit">
        <view class="quick-icon quick-icon-exit">出</view>
        <view class="quick-title">出场口</view>
        <view class="quick-desc">{{specialLoading === 'exit' ? '规划中…' : '从当前位置出发'}}</view>
      </view>
    </view>

    <view wx:if="{{collabGroup}}" class="collab-card" bindtap="openCollabGroup">
      <view class="collab-unread" wx:if="{{collabGroup.unreadCount > 0}}">{{collabGroup.unreadText}}</view>
      <view class="collab-head">
        <view class="collab-tag">任务协同</view>
        <view class="collab-status">进行中</view>
      </view>
      <view class="collab-title">{{collabGroup.title}}</view>
      <view class="collab-desc">{{collabGroup.desc}}</view>
      <view class="collab-foot">
        <view class="collab-members">{{collabGroup.memberText}}</view>
        <view class="collab-time" wx:if="{{collabGroup.lastMsgTimeText}}">{{collabGroup.lastMsgTimeText}}</view>
      </view>
    </view>
  </block>
</view>
