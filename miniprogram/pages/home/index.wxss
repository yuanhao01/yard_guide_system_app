/* 首页不用通用页的顶内边距，绿色顶栏要贴顶 */
.home-page {
  padding-top: 0;
}

/* 顶部深绿：从状态栏铺到堆场名，只占系统名 + 一行堆场的高度 */
.hero {
  margin: 0 -32rpx 24rpx;
  padding: 0 32rpx 24rpx;
  color: #ffffff;
  background: linear-gradient(180deg, #0c2820 0%, #12372a 50%, #1a694b 100%);
}

/* 自定义顶栏上的系统名，和右上角胶囊同一行 */
.hero-brand {
  color: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-align: center;
}

/* 堆场名和右侧「切换」横排 */
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 8rpx;
}

/* 左边：小字标签 + 堆场名同一行 */
.hero-info {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: baseline;
  min-width: 0;
  column-gap: 14rpx;
}

/* 能进多个堆场时右侧切换胶囊 */
.yard-switch {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* 岗位胶囊里当前堆场名，太长打点 */
.yard-switch-name {
  max-width: 200rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 胶囊里「切换」 */
.yard-switch-action {
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
}

/* 「当前堆场 / 岗位名」小字 */
.hero-label {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

/* 堆场名或岗位姓名 */
.hero-title {
  min-width: 0;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 岗位首页大字下的堆场名 */
.hero-sub {
  width: 100%;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

/* 司机进行中任务的橙色卡 */
.current-card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  overflow: hidden;
  border-radius: 24rpx;
  color: #ffffff;
  background: #d58424;
}

/* 橙色卡左上「进行中」 */
.current-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 21rpx;
}

/* 橙色卡标题：前往某某 */
.current-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

/* 橙色卡说明：剩余米数等 */
.current-detail {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

/* 橙色卡右下角「继续导航」 */
.current-action {
  position: absolute;
  right: 30rpx;
  bottom: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
}

/* 「作业导航 / 一键导航 / 协同交流群」小节标题 */
.section-title {
  margin: 0 4rpx 14rpx;
  color: #52635b;
  font-size: 25rpx;
  font-weight: 600;
}

/* 作业导航的大白卡：上面说明，下面两个按钮 */
.job-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e1e9e5;
  border-radius: 24rpx;
  background: #ffffff;
}

/* 卡片上半：图标 + 标题说明 */
.job-head {
  display: flex;
  align-items: center;
}

/* 卡片下半：手动选贝位、扫码两个按钮并排 */
.job-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

/* 卡片里的按钮，默认浅绿描边 */
.job-btn {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #147d55;
  border-radius: 18rpx;
  color: #147d55;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 主按钮：手动选择贝位，实心绿 */
.job-btn-main {
  color: #ffffff;
  background: #147d55;
}

/* 验箱区、出场口两块并排 */
.quick-grid {
  display: flex;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

/* 一键导航小卡：图标在左、文字在右，压低高度 */
.quick-card {
  display: flex;
  flex: 1;
  align-items: center;
  padding: 22rpx;
  border: 1rpx solid #e1e9e5;
  border-radius: 24rpx;
  background: #ffffff;
}

/* 正在规划时变淡，防止连点 */
.quick-busy {
  opacity: 0.6;
}

/* 小卡左上方标 */
.quick-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

/* 验箱区：蓝色 */
.quick-icon-safety {
  color: #1d4f91;
  background: #e8f0fb;
}

/* 出场口：橙色 */
.quick-icon-exit {
  color: #9a5a0a;
  background: #fff0d9;
}

/* 方标右边的标题和说明 */
.quick-text {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

/* 小卡标题 */
.quick-title {
  font-size: 30rpx;
  font-weight: 700;
}

/* 小卡灰色说明 */
.quick-desc {
  margin-top: 4rpx;
  color: #7c8983;
  font-size: 22rpx;
}

/* 白卡左边绿色方标 */
.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #147d55;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

/* 「贝」字用浅橙底 */
.select-icon {
  color: #9a5a0a;
  background: #fff0d9;
}

/* 方标右边的标题和说明 */
.action-content {
  flex: 1;
  margin-left: 26rpx;
}

/* 白卡主标题 */
.action-title {
  font-size: 31rpx;
  font-weight: 700;
}

/* 白卡灰色说明 */
.action-desc {
  margin-top: 9rpx;
  color: #7c8983;
  font-size: 23rpx;
}

/* 协同群深蓝卡片 */
.collab-card {
  position: relative;
  margin: 0 0 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0f2c50, #1a4a7a);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 44, 80, 0.18);
}

/* 卡片顶：标签和进行中 */
.collab-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 72rpx;
}

/* 卡片右上角未读数字 */
.collab-unread {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  z-index: 2;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 77, 79, 0.35);
}

/* 「任务协同」小标签 */
.collab-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 20rpx;
}

/* 「进行中」绿字 */
.collab-status {
  color: #7dffa8;
  font-size: 22rpx;
}

/* 群名 */
.collab-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

/* 最后一句预览 */
.collab-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

/* 成员名和时间横排 */
.collab-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

/* 成员名那一行 */
.collab-members {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
}

/* 最近一条消息时间 */
.collab-time {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.56);
  font-size: 20rpx;
}

/* 一键导航上方的行车安全提示黄条 */
.safety-card {
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-left: 7rpx solid #d58424;
  border-radius: 6rpx 18rpx 18rpx 6rpx;
  background: #fff8eb;
}

/* 安全提示标题 */
.safety-title {
  color: #7c490a;
  font-size: 24rpx;
  font-weight: 700;
}

/* 安全提示正文 */
.safety-text {
  margin-top: 6rpx;
  color: #826a4c;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 岗位没有群时的虚线空状态 */
.empty-card {
  margin-bottom: 28rpx;
  padding: 42rpx 30rpx;
  border: 1rpx dashed #c5d4cc;
  border-radius: 24rpx;
  background: #f7faf8;
}

/* 空状态标题 */
.empty-title {
  color: #2d3d36;
  font-size: 30rpx;
  font-weight: 700;
}

/* 空状态说明 */
.empty-desc {
  margin-top: 12rpx;
  color: #7c8983;
  font-size: 23rpx;
  line-height: 1.7;
}
