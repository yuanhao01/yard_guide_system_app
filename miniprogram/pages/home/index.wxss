.home-page {
  padding-top: 0;
}

.hero {
  margin: 0 -32rpx 36rpx;
  padding: 64rpx 40rpx 52rpx;
  border-radius: 0 0 44rpx 44rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #12372a, #1a694b);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.yard-switch {
  flex-shrink: 0;
  min-width: 180rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  text-align: right;
}

.yard-switch-name {
  max-width: 220rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.yard-switch-action {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
}

.hero-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.hero-title {
  margin: 12rpx 0 26rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-status {
  font-size: 24rpx;
}

.status-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #62e6a8;
}

.current-card {
  position: relative;
  margin-bottom: 36rpx;
  padding: 30rpx;
  overflow: hidden;
  border-radius: 24rpx;
  color: #ffffff;
  background: #d58424;
}

.current-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 21rpx;
}

.current-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.current-detail {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.current-action {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.section-title {
  margin: 0 4rpx 20rpx;
  color: #52635b;
  font-size: 25rpx;
  font-weight: 600;
}

.action-card {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e1e9e5;
  border-radius: 24rpx;
  background: #ffffff;
}

.action-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #147d55;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 92rpx;
  text-align: center;
}

.select-icon {
  color: #9a5a0a;
  background: #fff0d9;
}

.action-content {
  flex: 1;
  margin-left: 26rpx;
}

.action-title {
  font-size: 31rpx;
  font-weight: 700;
}

.action-desc {
  margin-top: 9rpx;
  color: #7c8983;
  font-size: 23rpx;
}

.arrow {
  color: #9ba7a1;
  font-size: 50rpx;
}

.collab-card {
  margin: 8rpx 0 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #0f2c50, #1a4a7a);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 44, 80, 0.18);
}

.collab-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.collab-tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 20rpx;
}

.collab-status {
  color: #7dffa8;
  font-size: 22rpx;
}

.collab-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.collab-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.collab-members {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
}

.safety-card {
  margin-top: 42rpx;
  padding: 26rpx;
  border-left: 7rpx solid #d58424;
  border-radius: 6rpx 18rpx 18rpx 6rpx;
  background: #fff8eb;
}

.safety-title {
  color: #7c490a;
  font-size: 25rpx;
  font-weight: 700;
}

.safety-text {
  margin-top: 10rpx;
  color: #826a4c;
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-card {
  margin-bottom: 28rpx;
  padding: 42rpx 30rpx;
  border: 1rpx dashed #c5d4cc;
  border-radius: 24rpx;
  background: #f7faf8;
}

.empty-title {
  color: #2d3d36;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: #7c8983;
  font-size: 23rpx;
  line-height: 1.7;
}
