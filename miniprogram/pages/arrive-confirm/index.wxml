<!-- 到位确认：顶栏、已到达卡片、集卡小景、直接确认 -->
<view class="page arrive-page">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="hero-inner">
      <view class="hero-back" bindtap="goBack">‹</view>
      <view class="hero-text">
        <view class="hero-title">到位确认</view>
        <view class="hero-sub">{{targetName || '--'}}</view>
      </view>
      <view class="hero-deco" aria-hidden="true"></view>
    </view>
  </view>

  <view class="card">
    <view class="ok-row">
      <view class="ok-badge">✓</view>
      <view class="ok-body">
        <view class="ok-title">已到达 {{targetName || '--'}}</view>
        <view class="ok-sub">{{equipmentHint}}</view>
      </view>
    </view>

    <!-- 三维小景：集卡停在车道上 -->
    <view class="scene-wrap">
      <canvas type="webgl" id="arriveCanvas" class="arrive-canvas"></canvas>
      <view class="scene-overlay" aria-hidden="true">
        <view class="scene-tag">
          <text>当前位置</text>
          <view class="scene-tag-tail"></view>
        </view>
        <view class="parking-box"></view>
      </view>
    </view>

    <!-- 到位时间、箱区校验、定位精度 -->
    <view class="meta">
      <view class="meta-item">
        <view class="meta-left">
          <view class="meta-icon meta-icon-time"></view>
          <text class="meta-cap">到位时间</text>
        </view>
        <view class="meta-val">{{arriveTime}}</view>
      </view>
      <view class="meta-item">
        <view class="meta-left">
          <view class="meta-icon meta-icon-check"></view>
          <text class="meta-cap">箱区校验</text>
        </view>
        <view class="meta-val ok">{{verifyLabel}} ✓</view>
      </view>
      <view class="meta-item">
        <view class="meta-left">
          <view class="meta-icon meta-icon-gps"></view>
          <text class="meta-cap">定位精度</text>
        </view>
        <view class="meta-val">{{accuracyText}}</view>
      </view>
    </view>

    <view class="tip">{{parkTip}}</view>

    <button class="primary" loading="{{confirming}}" bindtap="onConfirmTap">
      <text>{{confirmBtnText}}</text>
    </button>
    <button class="secondary" bindtap="renavigate">走错了？重新导航</button>
  </view>

  <view class="steps">
    <view class="step done"><text class="n">✓</text>任务确认</view>
    <view class="step-line"></view>
    <view class="step done"><text class="n">✓</text>场内导航</view>
    <view class="step-line"></view>
    <view class="step active"><text class="n">3</text>{{stepLabel}}</view>
  </view>
</view>
