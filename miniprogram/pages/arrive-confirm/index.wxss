/* 到位确认整页浅灰底，底部避开手机横条 */
.arrive-page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #eef2f7;
}

/* 顶部深蓝标题区 */
.hero {
  width: 100%;
  color: #fff;
  background: linear-gradient(145deg, #0f2c50 0%, #1a4a7a 72%, #1268e8 140%);
}

/* 返回、标题、装饰横排 */
.hero-inner {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 28rpx 108rpx;
  overflow: hidden;
}

/* 左上返回箭头 */
.hero-back {
  z-index: 1;
  width: 56rpx;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

/* 标题文字区 */
.hero-text {
  z-index: 1;
  flex: 1;
  min-width: 0;
}

/* 「到位确认」 */
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

/* 目的地名 */
.hero-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

/* 右下角装饰块，不挡点击 */
.hero-deco {
  position: absolute;
  right: -16rpx;
  bottom: 24rpx;
  width: 200rpx;
  height: 128rpx;
  border-radius: 48rpx 0 0 88rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
  pointer-events: none;
}

/* 上移压住蓝底的白色内容卡 */
.card {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1;
  flex-direction: column;
  margin: -88rpx 0 0;
  padding: 36rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(15, 44, 80, 0.12);
}

/* 绿色对号和「已到达」横排 */
.ok-row {
  display: flex;
  align-items: center;
}

/* 绿色对号圆 */
.ok-badge {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #fff;
  background: #18a05a;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

/* 「已到达某某」 */
.ok-title {
  color: #0f2c50;
  font-size: 34rpx;
  font-weight: 700;
}

/* 机械状态说明 */
.ok-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

/* 集卡小景外框 */
.scene-wrap {
  position: relative;
  flex: 1;
  margin-top: 28rpx;
  min-height: 420rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #dbe4ee;
}

/* 三维画布铺满小景 */
.arrive-canvas {
  width: 100%;
  height: 100%;
}

/* 「当前位置」标签和停车虚框叠在画布上，不挡手势 */
.scene-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

/* 小景画不出来时的兜底文字 */
.scene-fallback {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

/* 「当前位置」气泡 */
.scene-tag {
  position: absolute;
  top: 18%;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  color: #1d4ed8;
  background: rgba(255, 255, 255, 0.96);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(15, 44, 80, 0.08);
}

/* 气泡下面的小三角 */
.scene-tag-tail {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  width: 0;
  height: 0;
  margin-left: -10rpx;
  border-top: 12rpx solid rgba(255, 255, 255, 0.96);
  border-right: 10rpx solid transparent;
  border-left: 10rpx solid transparent;
}

/* 停车位虚线框 */
.parking-box {
  position: absolute;
  top: 42%;
  left: 50%;
  width: 160rpx;
  height: 220rpx;
  transform: translate(-50%, -20%);
  border: 3rpx dashed #2563eb;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 时间 / 校验 / 精度 三行 */
.meta {
  margin-top: 32rpx;
  padding-top: 8rpx;
}

/* 一行：左边图标+名，右边值 */
.meta-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  font-size: 26rpx;
}

/* 左边图标和名称 */
.meta-left {
  display: flex;
  align-items: center;
}

/* 通用小圆图标底 */
.meta-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #e8f1fc;
}

/* 到位时间图标 */
.meta-icon-time {
  background: #e8f1fc radial-gradient(circle at 50% 55%, #1268e8 0, #1268e8 28%, transparent 30%);
}

/* 箱区校验图标 */
.meta-icon-check {
  background: #e6f4ed radial-gradient(circle at 50% 55%, #18a05a 0, #18a05a 28%, transparent 30%);
}

/* 定位精度图标 */
.meta-icon-gps {
  background: #fef3e2 radial-gradient(circle at 50% 55%, #f59e0b 0, #f59e0b 28%, transparent 30%);
}

/* 行名灰色 */
.meta-cap {
  color: #64748b;
}

/* 行值深蓝 */
.meta-val {
  color: #0f2c50;
  font-weight: 600;
}

/* 校验通过用绿色 */
.meta-val.ok {
  color: #18a05a;
}

/* 「请听从机械手指挥停车」蓝条 */
.tip {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  color: #1268e8;
  background: #e8f1fc;
  font-size: 24rpx;
  text-align: center;
}

/* 确认到位 / 重新导航 两个按钮共用高度 */
.primary,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 0;
  width: 100%;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  box-sizing: border-box;
}

/* 去掉微信按钮边框 */
.primary::after,
.secondary::after {
  border: none;
}

/* 绿色主确认按钮 */
.primary {
  color: #fff;
  background: #18a05a;
}

/* 扫码图标 */
.btn-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
  font-weight: 400;
}

/* 「走错了？重新导航」白底蓝字 */
.secondary {
  color: #1268e8;
  background: #fff;
  border: 2rpx solid #c7daf5 !important;
}

/* 底部三步进度 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 40rpx;
}

/* 未强调的步骤 */
.step {
  display: flex;
  align-items: center;
  color: #94a3b8;
  font-size: 22rpx;
}

/* 已完成和当前步骤蓝字 */
.step.done,
.step.active {
  color: #1268e8;
  font-weight: 600;
}

/* 步骤序号圆 */
.step .n {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #e2e8f0;
  font-size: 20rpx;
}

/* 已完成和当前序号实心蓝 */
.step.done .n,
.step.active .n {
  color: #fff;
  background: #1268e8;
}

/* 步骤之间短线 */
.step-line {
  width: 48rpx;
  height: 2rpx;
  margin: 0 12rpx;
  background: #dbe3ee;
}
