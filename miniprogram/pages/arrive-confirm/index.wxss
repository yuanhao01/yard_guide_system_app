.arrive-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #eef2f7;
}

.hero {
  padding: 36rpx 40rpx 100rpx;
  color: #fff;
  background: linear-gradient(145deg, #0f2c50, #1a4a7a 70%, #1268e8);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.card {
  margin: -70rpx 28rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(15, 44, 80, 0.12);
}

.ok-row {
  display: flex;
  align-items: center;
}

.ok-badge {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #fff;
  background: #18a05a;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.ok-title {
  color: #0f2c50;
  font-size: 34rpx;
  font-weight: 700;
}

.ok-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

.scene-wrap {
  position: relative;
  margin-top: 28rpx;
  height: 320rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #dbe4ee;
}

.arrive-canvas {
  width: 100%;
  height: 100%;
}

.scene-tag {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-120rpx);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: #1d4ed8;
  background: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  font-weight: 700;
}

.meta {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef2f6;
}

.meta-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
  font-size: 26rpx;
}

.meta-cap {
  color: #94a3b8;
}

.meta-val {
  color: #0f2c50;
  font-weight: 600;
}

.meta-val.ok {
  color: #18a05a;
}

.meta-src {
  margin: -10rpx 0 12rpx;
  color: #94a3b8;
  font-size: 20rpx;
  text-align: right;
}

.tip {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  color: #1268e8;
  background: #e8f1fc;
  font-size: 24rpx;
  text-align: center;
}

.primary,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 28rpx 0;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  box-sizing: border-box;
}

.primary::after,
.secondary::after {
  border: none;
}

.primary {
  color: #fff;
  background: #18a05a;
}

.secondary {
  color: #1268e8;
  background: #e8f1fc;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 32rpx;
}

.step {
  display: flex;
  align-items: center;
  color: #94a3b8;
  font-size: 22rpx;
}

.step.done,
.step.active {
  color: #1268e8;
  font-weight: 600;
}

.step .n {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #e2e8f0;
  font-size: 20rpx;
}

.step.done .n,
.step.active .n {
  color: #fff;
  background: #1268e8;
}

.step-line {
  width: 40rpx;
  height: 2rpx;
  margin: 0 10rpx;
  background: #dbe3ee;
}
