.arrive-page {
  box-sizing: border-box;
  width: 100vw;
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #eef2f7;
}

.hero {
  width: 100%;
  color: #fff;
  background: linear-gradient(145deg, #0f2c50 0%, #1a4a7a 72%, #1268e8 140%);
}

.hero-inner {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 28rpx 108rpx;
  overflow: hidden;
}

.hero-back {
  z-index: 1;
  width: 56rpx;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.hero-text {
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-deco {
  position: absolute;
  right: -16rpx;
  bottom: 24rpx;
  width: 200rpx;
  height: 128rpx;
  border-radius: 48rpx 0 0 88rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
  pointer-events: none;
}

.card {
  position: relative;
  z-index: 2;
  margin: -88rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-shadow: 0 16rpx 40rpx rgba(15, 44, 80, 0.12);
}

.ok-row {
  display: flex;
  align-items: center;
}

.ok-badge {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  color: #fff;
  background: #18a05a;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.ok-title {
  color: #0f2c50;
  font-size: 34rpx;
  font-weight: 700;
}

.ok-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
}

.scene-wrap {
  position: relative;
  margin-top: 28rpx;
  height: 380rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #dbe4ee;
}

.arrive-canvas {
  width: 100%;
  height: 100%;
}

.scene-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.scene-tag {
  position: absolute;
  top: 22%;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  color: #1d4ed8;
  background: rgba(255, 255, 255, 0.96);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(15, 44, 80, 0.08);
}

.scene-tag-tail {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  width: 0;
  height: 0;
  margin-left: -10rpx;
  border-top: 12rpx solid rgba(255, 255, 255, 0.96);
  border-right: 10rpx solid transparent;
  border-left: 10rpx solid transparent;
}

.parking-box {
  position: absolute;
  top: 38%;
  left: 50%;
  width: 132rpx;
  height: 248rpx;
  transform: translateX(-58%);
  border: 3rpx dashed #2563eb;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.meta {
  margin-top: 32rpx;
  padding-top: 8rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  font-size: 26rpx;
}

.meta-left {
  display: flex;
  align-items: center;
}

.meta-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #e8f1fc;
}

.meta-icon-time {
  background: #e8f1fc radial-gradient(circle at 50% 55%, #1268e8 0, #1268e8 28%, transparent 30%);
}

.meta-icon-check {
  background: #e6f4ed radial-gradient(circle at 50% 55%, #18a05a 0, #18a05a 28%, transparent 30%);
}

.meta-icon-gps {
  background: #fef3e2 radial-gradient(circle at 50% 55%, #f59e0b 0, #f59e0b 28%, transparent 30%);
}

.meta-cap {
  color: #64748b;
}

.meta-val {
  color: #0f2c50;
  font-weight: 600;
}

.meta-val.ok {
  color: #18a05a;
}

.tip {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  color: #1268e8;
  background: #e8f1fc;
  font-size: 24rpx;
  text-align: center;
}

.primary,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 0;
  width: 100%;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  box-sizing: border-box;
}

.primary::after,
.secondary::after {
  border: none;
}

.primary {
  color: #fff;
  background: #18a05a;
}

.btn-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
  font-weight: 400;
}

.secondary {
  color: #1268e8;
  background: #fff;
  border: 2rpx solid #c7daf5 !important;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 40rpx;
}

.step {
  display: flex;
  align-items: center;
  color: #94a3b8;
  font-size: 22rpx;
}

.step.done,
.step.active {
  color: #1268e8;
  font-weight: 600;
}

.step .n {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #e2e8f0;
  font-size: 20rpx;
}

.step.done .n,
.step.active .n {
  color: #fff;
  background: #1268e8;
}

.step-line {
  width: 48rpx;
  height: 2rpx;
  margin: 0 12rpx;
  background: #dbe3ee;
}
