/* 整页浅底；顶栏颜色交给品牌区自己铺满，避免再叠一层底色 */
page {
  background: #eef2f0;
}

.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 40rpx 56rpx;
  background: #eef2f0;
}

/* 顶部深绿品牌区：从状态栏一直铺下来，不再单独圆角切一层 */
.hero {
  position: relative;
  margin: 0 -40rpx;
  padding: 0 48rpx 88rpx;
  overflow: hidden;
  background: linear-gradient(165deg, #0c2820 0%, #124836 46%, #176f4e 100%);
}

/* 品牌文字居中叠在绿色背景上 */
.brand {
  position: relative;
  z-index: 1;
  color: #ffffff;
  text-align: center;
}

/* 「场」字方标 */
.brand-mark {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 104rpx;
}

/* 「堆场引导系统」大标题 */
.brand-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 标题下那句登录说明 */
.brand-subtitle {
  max-width: 520rpx;
  margin: 16rpx auto 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.55;
}

/* 上移压住绿色区的白色登录卡片 */
.login-card {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 40rpx 32rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(12, 40, 29, 0.1), 0 4rpx 16rpx rgba(12, 40, 29, 0.04);
}

/* 司机 / 现场人员两个页签的底槽 */
.kind-tabs {
  display: flex;
  margin: 0 0 32rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  background: #edf3f0;
}

/* 未选中的页签 */
.kind-tab {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  color: #5f7169;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  transition: color 0.2s;
}

/* 当前选中的页签：白底绿字 */
.kind-tab.active {
  color: #0f6b4a;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(15, 107, 74, 0.1);
}

/* 「车牌号 / 堆场 / 账号」这类字段标题 */
.field-label {
  margin: 4rpx 0 12rpx;
  color: #3d4f47;
  font-size: 24rpx;
  font-weight: 600;
}

/* 输入框和堆场选择看起来一样高 */
.field-input {
  box-sizing: border-box;
  height: 96rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e4ebe7;
  border-radius: 18rpx;
  background: #f9fbfa;
  font-size: 28rpx;
}

/* 输入框点进去时边框变绿 */
.field-input:focus {
  border-color: #1a7a55;
  background: #ffffff;
}

/* 堆场下拉显示的那一行文字垂直居中 */
.picker-value {
  line-height: 96rpx;
}

/* 还没选堆场时的灰色提示字 */
.picker-value.placeholder {
  color: #9aa8a2;
}

/* 「进入堆场 / 登录」主按钮 */
.login-button {
  margin-top: 8rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #147d55 0%, #1a9464 100%);
}

/* 最底下定位用途那一行小字 */
.privacy-tip {
  margin-top: 28rpx;
  color: #8a9690;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* 堆场名单失败时的橙色原因 */
.yards-error {
  margin: -16rpx 0 20rpx;
  color: #b45309;
  font-size: 22rpx;
  line-height: 1.5;
}

/* 按钮下面那句「不用预先建账号」说明 */
.login-tip {
  margin-top: 24rpx;
  color: #5a8f76;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

/* 说明和隐私提示挨着时少留一点空 */
.login-tip + .privacy-tip {
  margin-top: 12rpx;
}
