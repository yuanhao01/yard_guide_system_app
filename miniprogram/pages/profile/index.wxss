/* 我的页顶部多留一点空，头像卡不贴顶 */
.profile-page {
  padding-top: 48rpx;
}

/* 顶部绿色资料卡：头像和姓名横排 */
.profile-card {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
  padding: 38rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #12372a, #1a694b);
}

/* 圆形头像，中间一个字 */
.avatar {
  width: 104rpx;
  height: 104rpx;
  margin-right: 26rpx;
  border-radius: 50%;
  color: #155f44;
  background: #e9f6ef;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

/* 姓名 */
.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

/* 姓名下的身份说明 */
.user-account {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 23rpx;
}

/* 下面那张白卡去掉多余内边距，改由每一行自己撑开 */
.info-card {
  padding: 0 30rpx;
}

/* 一行信息：左边名、右边值 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #edf1ef;
  font-size: 27rpx;
}

/* 右边的值用灰色 */
.info-row text:last-child {
  color: #718078;
}

/* 「系统权限设置」右边的箭头 */
.arrow {
  font-size: 40rpx;
}
