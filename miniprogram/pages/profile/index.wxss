.profile-page {
  padding-top: 48rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  margin-bottom: 34rpx;
  padding: 38rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #12372a, #1a694b);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  margin-right: 26rpx;
  border-radius: 50%;
  color: #155f44;
  background: #e9f6ef;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 104rpx;
  text-align: center;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
}

.user-account {
  margin-top: 9rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 23rpx;
}

.info-card {
  padding: 0 30rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #edf1ef;
  font-size: 27rpx;
}

.info-row text:last-child {
  color: #718078;
}

.arrow {
  font-size: 40rpx;
}
