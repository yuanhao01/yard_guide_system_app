/* 页顶「按堆场 → 场区 → 贝位」提示 */
.hint {
  margin: 4rpx 4rpx 20rpx;
  color: #53635b;
  font-size: 25rpx;
  font-weight: 600;
}

/* 三级选择那张白卡 */
.selector-card {
  padding: 4rpx 32rpx;
}

/* 一行：左边步骤名，右边当前选中值 */
.selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
}

/* 「1 堆场」这类标签 */
.selector-label {
  font-size: 28rpx;
  font-weight: 600;
}

/* 步骤序号绿圆 */
.step-number {
  display: inline-block;
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #147d55;
  background: #e6f4ed;
  font-size: 23rpx;
  line-height: 42rpx;
  text-align: center;
}

/* 右边已选中的堆场/场区/贝位 */
.picker-value {
  max-width: 390rpx;
  color: #18271f;
  font-size: 27rpx;
  text-align: right;
}

/* 还没选时的灰色占位 */
.placeholder {
  color: #96a19b;
}

/* 三行之间的细线 */
.divider {
  height: 1rpx;
  background: #edf1ef;
}

/* 底部「提空箱可反显贝位」说明 */
.footer-tip {
  margin-top: 28rpx;
  color: #849089;
  font-size: 23rpx;
  text-align: center;
}
