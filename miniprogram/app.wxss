page {
  min-height: 100%;
  background: #f4f6f5;
  color: #17251f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #e2e9e5;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(22, 56, 42, 0.06);
}

.primary-button,
.secondary-button,
.danger-button {
  height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.primary-button {
  color: #ffffff;
  background: #147d55;
}

.secondary-button {
  color: #147d55;
  background: #e8f4ee;
}

.danger-button {
  color: #b42318;
  background: #feeceb;
}

.muted {
  color: #718078;
}

.empty {
  padding: 80rpx 24rpx;
  color: #718078;
  text-align: center;
}
