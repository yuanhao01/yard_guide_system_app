/* 整块：格子 + 新能源勾选 */
.plate-input {
  margin-bottom: 28rpx;
}

/* 一排车牌格子 */
.cells {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 单个格子，和登录页输入框同色系 */
.cell {
  flex: 1;
  height: 96rpx;
  border: 2rpx solid #e4ebe7;
  border-radius: 14rpx;
  background: #f9fbfa;
  color: #12372a;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}

/* 省份格稍深，提示从这里开始 */
.cell.province {
  background: #eef4f1;
}

/* 新能源第 8 位用绿色虚线框 */
.cell.energy {
  border-style: dashed;
  border-color: #3fae6f;
}

/* 正在填的格子：实线深绿框 + 浅绿底，新能源位也一样，盖过虚线 */
.cell.active {
  border: 3rpx solid #1a7a55;
  background: #e3f3ea;
  box-shadow: 0 0 0 4rpx rgba(26, 122, 85, 0.15);
}

/* 省份格空着时的灰字 */
.cell-hint {
  color: #9aa8a2;
  font-size: 24rpx;
  font-weight: 400;
}

/* 新能源勾选 */
.energy-toggle {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  color: #66756e;
  font-size: 24rpx;
}

.energy-toggle .check {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border: 2rpx solid #b9c6c0;
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.energy-toggle.on {
  color: #1a7a55;
}

.energy-toggle.on .check {
  border-color: #3fae6f;
  background: #3fae6f;
}

/* 键盘外的透明遮罩，点了收起 */
.keyboard-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 98;
}

/* 底部键盘，平时藏在屏幕下面 */
.keyboard {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  padding: 0 12rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #d7dde0;
  transform: translateY(100%);
  transition: transform 0.2s ease;
}

.keyboard.show {
  transform: translateY(0);
}

/* 键盘顶部：提示当前填哪一位 + 完成 */
.keyboard-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 12rpx;
}

.keyboard-title {
  color: #3d4f47;
  font-size: 26rpx;
}

.keyboard-done {
  color: #1a7a55;
  font-size: 30rpx;
  font-weight: 600;
}

/* 按键：一行 10 个 */
.keys {
  display: flex;
  flex-wrap: wrap;
}

.key {
  box-sizing: border-box;
  width: calc(10% - 10rpx);
  height: 84rpx;
  margin: 5rpx;
  border-radius: 10rpx;
  background: #ffffff;
  color: #12372a;
  font-size: 32rpx;
  line-height: 84rpx;
  text-align: center;
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.12);
}

.key:active {
  background: #cfe6db;
}

/* 第 2 位时数字不能点 */
.key.disabled {
  color: #c3ccc8;
  background: #eef1f2;
}

/* 删除键占两格 */
.key-del {
  width: calc(20% - 10rpx);
  background: #b9c3c8;
  font-size: 26rpx;
}
